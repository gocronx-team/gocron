{
  "name": "@gocronx/gocronx-admin",
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.3",
  "description": "A modern Vue3 admin template for GoCronX projects",
  "author": "gocronx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gocronx/gocronx-admin.git"
  },
  "homepage": "https://github.com/gocronx/gocronx-admin",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=8.8.0"
  },
  "scripts": {
    "dev": "vite --open",
    "build": "vue-tsc --noEmit && vite build",
    "build-only": "vite build",
    "serve": "vite preview",
    "lint": "eslint",
    "fix": "eslint --fix",
    "lint:prettier": "prettier --write \"**/*.{js,cjs,ts,json,tsx,css,less,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint  \"**/*.{css,scss,vue}\" --fix",
    "lint:lint-staged": "lint-staged",
    "commit": "git-cz",
    "clean:dev": "tsx scripts/clean-dev.ts"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,ts,mjs,mts,tsx}": [
      "pnpm exec eslint --fix",
      "pnpm exec prettier --write"
    ],
    "*.{cjs,json,jsonc}": [
      "pnpm exec prettier --write"
    ],
    "*.vue": [
      "pnpm exec eslint --fix",
      "pnpm exec stylelint --fix --allow-empty-input",
      "pnpm exec prettier --write"
    ],
    "*.{html,htm}": [
      "pnpm exec prettier --write"
    ],
    "*.{scss,css,less}": [
      "pnpm exec stylelint --fix --allow-empty-input",
      "pnpm exec prettier --write"
    ],
    "*.{md,mdx}": [
      "pnpm exec prettier --write"
    ],
    "*.{yaml,yml}": [
      "pnpm exec prettier --write"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify/vue": "^5.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@vue/reactivity": "^3.5.38",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.17.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.1",
    "file-saver": "^2.0.5",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "ohash": "^2.0.11",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qrcode.vue": "^3.9.1",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.38",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.5",
    "vue-router": "^5.1.0",
    "xgplayer": "^3.0.24"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@iconify-json/iconamoon": "^1.2.2",
    "@iconify-json/ri": "^1.2.10",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "^3.5.38",
    "commitizen": "^4.3.0",
    "cz-git": "^1.13.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "husky": "^9.1.5",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.101.0",
    "stylelint": "^17.13.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard": "^40.0.0",
    "terser": "^5.48.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.16",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vue-demi": "^0.14.9",
    "vue-img-cutter": "^3.1.1",
    "vue-tsc": "~3.3.4"
  }
}
