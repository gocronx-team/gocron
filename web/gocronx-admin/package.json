{
  "name": "@gocronx/gocronx-admin",
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.3",
  "description": "A modern Vue3 admin template for GoCronX projects",
  "author": "gocronx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gocronx/gocronx-admin.git"
  },
  "homepage": "https://github.com/gocronx/gocronx-admin",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=8.8.0"
  },
  "scripts": {
    "dev": "vite --open",
    "build": "vite build && vue-tsc --noEmit",
    "build-only": "vite build",
    "serve": "vite preview",
    "lint": "eslint",
    "fix": "eslint --fix",
    "lint:prettier": "prettier --write \"**/*.{js,cjs,ts,json,tsx,css,less,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint  \"**/*.{css,scss,vue}\" --fix",
    "lint:lint-staged": "lint-staged",
    "commit": "git-cz",
    "clean:dev": "tsx scripts/clean-dev.ts"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,ts,mjs,mts,tsx}": [
      "pnpm exec eslint --fix",
      "pnpm exec prettier --write"
    ],
    "*.{cjs,json,jsonc}": [
      "pnpm exec prettier --write"
    ],
    "*.vue": [
      "pnpm exec eslint --fix",
      "pnpm exec stylelint --fix --allow-empty-input",
      "pnpm exec prettier --write"
    ],
    "*.{html,htm}": [
      "pnpm exec prettier --write"
    ],
    "*.{scss,css,less}": [
      "pnpm exec stylelint --fix --allow-empty-input",
      "pnpm exec prettier --write"
    ],
    "*.{md,mdx}": [
      "pnpm exec prettier --write"
    ],
    "*.{yaml,yml}": [
      "pnpm exec prettier --write"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify/vue": "^5.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vue/reactivity": "^3.5.40",
    "@vueuse/core": "^13.9.0",
    "axios": "^1.19.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.11.2",
    "file-saver": "^2.0.5",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "ohash": "^2.0.11",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qrcode.vue": "^3.10.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^9.14.0",
    "vue-router": "^4.6.4",
    "xgplayer": "^3.0.26"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.1",
    "@commitlint/config-conventional": "^19.4.1",
    "@eslint/js": "^9.39.5",
    "@iconify-json/iconamoon": "^1.2.2",
    "@iconify-json/ri": "^1.2.10",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.40",
    "commitizen": "^4.3.2",
    "cz-git": "^1.13.1",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^10.2.0",
    "globals": "^15.9.0",
    "husky": "^9.1.5",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.102.0",
    "stylelint": "^16.26.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^4.6.0",
    "stylelint-config-recommended-scss": "^14.1.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard": "^36.0.1",
    "terser": "^5.49.1",
    "tsx": "^4.23.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.9.0",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^29.2.0",
    "vite": "^7.3.6",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^7.7.10",
    "vue-demi": "^0.14.9",
    "vue-img-cutter": "^3.1.1",
    "vue-tsc": "~2.2.12"
  }
}
