{
  "name": "gocron",
  "version": "2.0.0",
  "description": "定时任务管理系统",
  "author": "gocronx <gocronx@gmail.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "commit": "git-cz",
    "lint:lint-staged": "lint-staged"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "web/gocronx-admin/**/*.{js,ts,vue}": [
      "cd web/gocronx-admin && pnpm exec eslint --fix",
      "cd web/gocronx-admin && pnpm exec prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "cd web/gocronx-admin && pnpm exec prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "lodash": ">=4.18.0",
      "tmp": ">=0.2.6",
      "flatted": ">=3.4.2",
      "fast-uri": "^3.1.2"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "commitizen": "^4.3.1",
    "cz-git": "^1.13.1",
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4"
  }
}
