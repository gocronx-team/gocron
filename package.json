{
  "name": "gocron",
  "version": "2.0.0",
  "packageManager": "pnpm@10.34.3",
  "description": "定时任务管理系统",
  "author": "gocronx <gocronx@gmail.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "commit": "git-cz",
    "lint:lint-staged": "lint-staged"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "web/gocronx-admin/**/*.{js,ts,vue}": [
      "cd web/gocronx-admin && pnpm exec eslint --fix",
      "cd web/gocronx-admin && pnpm exec prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "cd web/gocronx-admin && pnpm exec prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "commitizen": "^4.3.2",
    "cz-git": "^1.13.1",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5"
  }
}
